# Copy to .env (gitignored) and fill in. The scripts read it on this machine (libs/ranker/scripts/env.mjs);
# on GitHub the same names come from the repo's Actions secrets.

# The Odds API (the-odds-api.com): sportsbook lines and prices, props and history for the model desk
ODDS_API_KEY=

# Optional: highlights search for every game (libs/ranker/scripts/highlights.mjs)
YOUTUBE_API_KEY=
