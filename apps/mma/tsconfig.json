/* The UFC app: imports resolve from src/ (the engine as @ranker/*, this sport as @sport/*). The build and test configs extend this. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./src",
    // The shared ranker library (libs/ranker/src), and this sport's half of the engine's contract
    // (src/sport: SPORT, positions, presets, skills, awards, team colors, logo eras, About)
    "paths": {
      "@ranker/*": ["../../../libs/ranker/src/*"],
      "@sport/*": ["sport/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
