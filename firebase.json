{
  "hosting": {
    "public": "dist/site",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/nfl",
        "destination": "/nfl/index.html"
      },
      {
        "source": "/nfl/**",
        "destination": "/nfl/index.html"
      },
      {
        "source": "/mlb",
        "destination": "/mlb/index.html"
      },
      {
        "source": "/mlb/**",
        "destination": "/mlb/index.html"
      },
      {
        "source": "/nba",
        "destination": "/nba/index.html"
      },
      {
        "source": "/nba/**",
        "destination": "/nba/index.html"
      },
      {
        "source": "/nhl",
        "destination": "/nhl/index.html"
      },
      {
        "source": "/nhl/**",
        "destination": "/nhl/index.html"
      },
      {
        "source": "/mma",
        "destination": "/mma/index.html"
      },
      {
        "source": "/mma/**",
        "destination": "/mma/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^.*\\.[0-9a-f]{16}\\.(jpg|jpeg|png|svg|webp|gif|woff2?|ttf)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/[a-z]+/data/[^/]+\\.json$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/[a-z]+/data/(analysis|careers|depth)/.+\\.json$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/[a-z]+/data/(seasons|game-logs)/.+\\.json$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "/nfl/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/mlb/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/nba/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/nhl/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/mma/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/nfl/",
        "type": 301
      }
    ]
  }
}
