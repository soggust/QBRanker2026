{
  "name": "qbranker",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node dev.mjs",
    "start": "ng serve nfl",
    "build": "ng build nfl && ng build mlb && ng build nba && ng build nhl",
    "rollover": "node scripts/rollover.mjs",
    "watch": "ng build nfl --watch --configuration development",
    "test": "ng test nfl",
    "update-data": "node apps/nfl/scripts/update-data.mjs",
    "update-honors": "node apps/nfl/scripts/update-honors.mjs",
    "build-comps": "node apps/nfl/scripts/build-comps.mjs",
    "build-blocking": "node --max-old-space-size=6144 apps/nfl/scripts/build-blocking.mjs",
    "start:mlb": "ng serve mlb",
    "mlb:update-data": "node apps/mlb/scripts/update-data.mjs",
    "mlb:build-comps": "node apps/mlb/scripts/build-comps.mjs",
    "start:nba": "ng serve nba",
    "nba:update-data": "node apps/nba/scripts/update-data.mjs",
    "nba:build-comps": "node apps/nba/scripts/build-comps.mjs",
    "new-sport": "node scripts/new-sport.mjs",
    "start:nhl": "ng serve nhl",
    "nhl:update-data": "node apps/nhl/scripts/update-data.mjs",
    "nhl:build-comps": "node apps/nhl/scripts/build-comps.mjs",
    "start:mma": "ng serve mma",
    "mma:update-data": "node apps/mma/scripts/update-data.mjs",
    "nfl:analysis": "node apps/nfl/scripts/analysis/dossier.mjs --fresh && node apps/nfl/scripts/analysis/analyze.mjs --batch --teams --qbs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.11",
    "@angular/compiler": "^21.2.11",
    "@angular/core": "^21.2.11",
    "@angular/forms": "^21.2.11",
    "@angular/material": "^21.2.9",
    "@angular/platform-browser": "^21.2.11",
    "@angular/platform-browser-dynamic": "^21.2.11",
    "@angular/router": "^21.2.11",
    "firebase": "^12.12.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.7.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.9",
    "@angular/cli": "~21.2.9",
    "@angular/compiler-cli": "^21.2.11",
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/jasmine": "^6.0.0",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ts-loader": "^9.5.7",
    "typescript": "^5.9.3"
  }
}
